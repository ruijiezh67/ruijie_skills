{
  "description": "notary: log real tool output; send a reply back once if it states a number with no checked receipt",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" hook-log", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" hook-stop", "timeout": 20}
        ]
      }
    ]
  }
}
